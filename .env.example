# Copie para .env.local e preencha com as chaves do seu projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Chave server-only (NUNCA no frontend/NEXT_PUBLIC_, NUNCA no Git):
# SUPABASE_SERVICE_ROLE_KEY=

# Omie (conciliação → contas a pagar). Só no servidor (Vercel → Environment Variables / .env.local). Nunca no Git.
# Cada empresa tem a própria Omie: filiais 300 em diante (e TRIO) = Nazário; abaixo de 300 = Varela.
# OMIE_NAZARIO_APP_KEY=
# OMIE_NAZARIO_APP_SECRET=
# OMIE_VARELA_APP_KEY=
# OMIE_VARELA_APP_SECRET=

# Robô do Trier (conciliação → busca o relatório "Contas a Pagar ou Pagas" sozinho). Use um usuário do Trier
# criado SÓ para o robô, com acesso apenas a esse relatório. Só no servidor; nunca no Git.
# TRIER_URL=http://redefct.ddns.com.br:4647/sgfpod1/
# TRIER_USUARIO=
# TRIER_SENHA=

# Agente dos .RET do Itaú (/api/conciliacao/agente) e convite de usuários por e-mail precisam da
# SUPABASE_SERVICE_ROLE_KEY acima (o agente não tem sessão de usuário; o RLS é respeitado pelo código).
