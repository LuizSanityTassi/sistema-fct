# Copie para .env.local e preencha com as chaves do seu projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Chave server-only (NUNCA no frontend/NEXT_PUBLIC_, NUNCA no Git):
# SUPABASE_SERVICE_ROLE_KEY=

# Omie e Trier: o administrador cadastra pela TELA (Configurações → Integrações; ficam criptografados no Vault do
# Supabase). As variáveis abaixo são só uma alternativa para quem preferir ambiente — se existirem e nada estiver
# cadastrado na tela, valem elas. Nunca no Git.
# OMIE_NAZARIO_APP_KEY=
# OMIE_NAZARIO_APP_SECRET=
# OMIE_VARELA_APP_KEY=
# OMIE_VARELA_APP_SECRET=
# TRIER_URL=http://redefct.ddns.com.br:4647/sgfpod1/
# TRIER_USUARIO=
# TRIER_SENHA=

# Agente dos .RET do Itaú (/api/conciliacao/agente) e convite de usuários por e-mail usam a
# SUPABASE_SERVICE_ROLE_KEY acima (o agente não tem sessão de usuário). É a única variável que não dá para
# cadastrar pela tela. Sem ela, o convite cai no modo "e-mail de confirmação" (signUp) e o agente fica desligado.
